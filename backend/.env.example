# ============================================================
# Neura V5 — Backend Environment Configuration
# ============================================================
# This file is kept in sync with backend/src/config/env.ts.
# Every variable below is read by that schema. If you add or
# rename a variable in env.ts, update this file in the same PR.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------
# PostgreSQL / Prisma
# ------------------------------------------------------------
# Local development example:
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/neura?schema=public"

# Production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ------------------------------------------------------------
# Frontend URL / CORS
# ------------------------------------------------------------
# Origin allowed by CORS. Must match the frontend's actual URL exactly.
FRONTEND_URL=http://localhost:5173

# Production example:
# FRONTEND_URL=https://your-frontend-domain.com

# ------------------------------------------------------------
# Sessions
# ------------------------------------------------------------
# Name of the session cookie.
SESSION_COOKIE_NAME=neura_session

# Cookie SameSite policy. Use `none` when frontend and backend are on different sites
# (for example Vercel frontend + Render backend). `none` requires HTTPS in production.
SESSION_COOKIE_SAMESITE=lax

# Session lifetime, in days.
SESSION_TTL_DAYS=30

# ------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local callback example:
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Production example:
# GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/auth/google/callback

# Name of the temporary cookie used to store Google OAuth state.
GOOGLE_STATE_COOKIE_NAME=neura_google_state

# ------------------------------------------------------------
# Resend — Password Reset / Email
# ------------------------------------------------------------
# Required in production (env.ts throws at startup if missing when
# NODE_ENV=production). Optional in development/test.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Example:
# RESEND_FROM_EMAIL=Neura <no-reply@your-domain.com>

# ------------------------------------------------------------
# Gemini (AI provider)
# ------------------------------------------------------------
GEMINI_API_KEY=

# Model used for generating embeddings (RAG).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Sampling temperature for Gemini generations (0-2).
GEMINI_TEMPERATURE=0.7

# ------------------------------------------------------------
# OpenAI (alternate AI provider, via multi-model gateway)
# ------------------------------------------------------------
# Required only if using OpenAI through the multi-model gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Which provider is used by default when a request doesn't specify one.
# One of: google, openai
DEFAULT_AI_PROVIDER=google

# Inactivity timeout for AI provider streaming calls, in milliseconds. Aborts
# if no chunk of the response arrives within this window (resets on every
# chunk received), so a hung provider connection can't run forever.
AI_PROVIDER_TIMEOUT_MS=60000

# Max retries for a transient AI provider failure (rate limit, 5xx, timeout,
# network error), applied only before any tokens have streamed back.
AI_PROVIDER_MAX_RETRIES=2

# Base delay, in milliseconds, for exponential backoff between retries.
AI_PROVIDER_RETRY_BASE_MS=500

# ------------------------------------------------------------
# Tavily Web Research
# ------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com

# Max results returned per web search (1-20).
WEB_SEARCH_MAX_RESULTS=8

# Search depth. One of: basic, advanced, fast, ultra-fast
WEB_SEARCH_DEPTH=basic

# Timeout for a single web search request, in milliseconds.
WEB_SEARCH_TIMEOUT_MS=15000

# ------------------------------------------------------------
# Document Uploads
# ------------------------------------------------------------
# Local development storage directory (relative to backend/).
DOCUMENT_UPLOAD_DIR=uploads

# Maximum upload size, in megabytes.
DOCUMENT_MAX_SIZE_MB=20

# ------------------------------------------------------------
# RAG (Retrieval-Augmented Generation)
# ------------------------------------------------------------
# Number of chunks retrieved per query.
RAG_TOP_K=6

# Chunk size, in characters, when splitting documents for embedding.
RAG_CHUNK_SIZE=1200

# Overlap, in characters, between consecutive chunks.
RAG_CHUNK_OVERLAP=200

# ------------------------------------------------------------
# GitHub Integration
# ------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------
# Code Execution
# ------------------------------------------------------------
# Runs the "Developer Mode" code-execution feature via `docker run` with
# network/capability restrictions (see src/services/developerService.ts).
# This REQUIRES a host that can reach a Docker daemon — a VM or a host with
# Docker-in-Docker. It will NOT work on most PaaS/serverless hosts (e.g. a
# platform that runs your app in its own container with no docker socket
# exposed), and enabling it there will make GET /api/developer/status report
# unavailable and POST /api/developer/execute fail at runtime.
#
# Decision: leave this false unless you have confirmed your hosting target
# supports spawning `docker run` from the backend process. Frontends should
# call GET /api/developer/status and hide/disable the "Run" action when
# `available` is false, rather than letting the user hit an unexpected 403.
# One of: true, false
CODE_EXECUTION_ENABLED=false

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
# General API rate limit window, in milliseconds.
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window, per client, for general API routes.
RATE_LIMIT_MAX=300

# Max requests per window, per client, for auth routes (login, register, etc).
AUTH_RATE_LIMIT_MAX=20

# ------------------------------------------------------------
# Monitoring / Error Tracking (optional)
# ------------------------------------------------------------
# Leave blank to disable. When set, uncaught exceptions, unhandled
# rejections, and unhandled request/streaming errors are reported to Sentry.
# Requires `npm install` to pull in @sentry/node.
SENTRY_DSN=

# Fraction of transactions to trace (0-1). 0 disables performance tracing
# while still reporting errors.
SENTRY_TRACES_SAMPLE_RATE=0
